{
    "ConfigVersion": 1,

    "Paths": {
        "DataRoot": "..\\..\\..\\..\\Data",
        "TradesFile": "trades.csv",
        "DatasetFile": "dataset.csv",
        "CacheFolder": "cache",
        "CandidatesFolder": "candidates",
        "EvaluationsFolder": "evaluations",
        "WishListFile": "wishlist/current.json",
        "ProcessedCandidateFilesManifest": "manifests/processed-candidate-files.json",
        "LogsFolder": "logs"
    },

    "Tws": {
        "Host": "127.0.0.1",
        "Port": 7497,
        "ClientId": 7,
        "UseRth": false,
        "ConnectTimeoutSeconds": 15,
        "HistoryTimeoutSeconds": 60,
        "ReconnectDelaySeconds": 5,
        "MaxParallelHistoryRequests": 2,
        "HistoryRequestPauseMs": 250
    },

    "Market": {
        "Timezone": "America/New_York",
        "ExcludeOtc": true,
        "MinPrice": 1.0,
        "MaxPrice": 100.0,
        "MinAvgVolume": 500000,
        "MinDollarVolume": 1000000
    },

    "BuildDataset": {
        "MinimumCandlesRequired": 60,
        "IncludeSyntheticTrades": false,
        "MaxParallelTickers": 3,
        "HistoryWarmupDays": 120,
        "FuturePaddingDays": 21,
        "TickerAliases": {
            "NYCB": "FLG"
        },
        "EntryShifts": [ -12, -9, -6, -3, 0 ]
    },

    "FeatureCalculation": {
        "LookbackCandles": 300,
        "AvgVolumeWindow": 20
    },

    "GetCandidates": {
        "RowsPerScan": 50,
        "FinalTopCandidates": 10,
        "UseWishListFirst": true,
        "MaxWishListItems": 100,

        "ScanCodes": [
            {
                "Code": "TOP_OPEN_PERC_GAIN",
                "Description": "Top percentage gainer at open."
            },
            {
                "Code": "TOP_PERC_GAIN",
                "Description": "Top percentage gainers."
            },
            {
                "Code": "HOT_BY_VOLUME",
                "Description": "Most active by volume."
            },
            {
                "Code": "MOST_ACTIVE",
                "Description": "Most active stocks."
            }
        ],

        "TradePlan": {
            "MinimumCandles": 10,
            "StopLookbackBars": 5,
            "StopBufferMultiplier": 0.99,
            "FallbackStopMultiplier": 0.97,
            "RiskRewardRatio": 2.0
        },

        "CandidateFilter": {
            "MinDollarVolume": 1000000.0,
            "MaxBbMidSignedDistancePct": 0.5,
            "MaxDistanceTo20dHigh": -20.0,
            "MaxAtrRatio": 0.20
        },

        "Finder": {
            "CandleCount": 300,
            "MinimumCandles": 60,
            "AvgVolumePeriod": 20
        },

        "PreFilter": {
            "RequiredCurrency": "USD",
            "DenyList": [ "UVIX", "AGQ", "SCO", "MSTZ" ],
            "AllowedStockTypeMarkers": [ "STK", "CORP", "ADR" ],
            "RejectTickersEndingWith": [ "U", "W" ]
        }
    },

    "Evaluation": {
        "SearchPattern": "candidates_*.json",
        "ForwardEvaluationDays": 7,
        "FreshDataSafetyLagMinutes": 10,
        "DefaultTargetPct": 10.0,
        "UseAmbiguousBarResolver": true
    },

    "CsvTradeReader": {
        "Separator": ";",
        "HasHeader": true,
        "Columns": [
            {
                "Name": "HoldDays",
                "Index": 0
            },
            {
                "Name": "ProfitPercent",
                "Index": 1
            },
            {
                "Name": "Ticker",
                "Index": 2
            },
            {
                "Name": "EntryDate",
                "Index": 3
            },
            {
                "Name": "EntryTime",
                "Index": 4
            },
            {
                "Name": "EntryPrice",
                "Index": 6
            },
            {
                "Name": "ExitDate",
                "Index": 10
            },
            {
                "Name": "ExitTime",
                "Index": 11
            },
            {
                "Name": "ExitPrice",
                "Index": 13
            },
            {
                "Name": "IsShort",
                "Index": 19
            }
        ]
    }
}