{
    "ConfigVersion": 1,

    "Paths": {
        "DataRoot": "..\\..\\..\\..\\Data",
        "TradesFile": "trades.csv",
        "DatasetFile": "datasets/trade_dataset.csv",
        "CacheFolder": "cache",
        "CandidatesFile": "Tickers/candidates.json",
        "EvaluationsFile": "Tickers/evaluations.csv",
        "WishListFile": "Tickers/wishlist.json",
        "ProcessedCandidateFilesManifest": "manifests/processed-candidate-files.json",
        "LogsFolder": "logs"
    },

    "Tws": {
        "Host": "127.0.0.1",
        "Port": 7497,
        "ClientId": 7,
        "UseRth": false,
        "ConnectTimeoutSeconds": 15,
        "HistoryTimeoutSeconds": 60,
        "ReconnectDelaySeconds": 5,
        "MaxParallelHistoryRequests": 2,
        "HistoryRequestPauseMs": 250
    },

    "Market": {
        "Timezone": "America/New_York",
        "ExcludeOtc": true,
        "MinPrice": 5.0,
        "MaxPrice": 100.0,
        "MinAvgVolume": 500000,
        "MinDollarVolume": 1000000
    },

    "MarketSessions": {
        "UseExtendedHoursByDefault": true,
        "EnableHolidaySupport": false,
        "EnableEarlyCloseSupport": false,
        "TradingDays": [
            "Monday",
            "Tuesday",
            "Wednesday",
            "Thursday",
            "Friday"
        ],
        "PreMarket": {
            "Enabled": true,
            "Start": "04:00",
            "End": "09:30"
        },
        "RegularSession": {
            "Enabled": true,
            "Start": "09:30",
            "End": "16:00"
        },
        "AfterHours": {
            "Enabled": true,
            "Start": "16:00",
            "End": "20:00"
        },
        "TwsOverrides": {
            "Enabled": true,
            "PreferTwsTradingHours": true,
            "PreferTwsLiquidHours": false,
            "CacheTtlHours": 24
        },
        "Holidays": [],
        "EarlyCloses": []
    },

    "BuildDataset": {
        "MinimumCandlesRequired": 60,
        "IncludeSyntheticTrades": true,
        "MaxParallelTickers": 3,
        "HistoryWarmupDays": 120,
        "FuturePaddingDays": 21,
        "SyntheticEntryFractions": [ 0.25, 0.5, 0.75 ],
        "TickerAliases": {
            "NYCB": "FLG"
        }
    },

    "Research": {
        "Mode": "top_gainers",
        "Source": "known_tickers",
        "OutputFile": "datasets/research_top_gainers.csv",
        "LookbackCalendarDays": 240,
        "MinimumCandles": 120,
        "MaxParallelTickers": 2,
        "LocalExtremaLookbackBars": 3,
        "EpisodeMergeCooldownBars": 8,
        "MaxBarsToPeak": 30,
        "MinRunupPct": 20.0
    },

    "FeatureCalculation": {
        "LookbackCandles": 300,
        "AvgVolumeWindow": 20
    },

    "GetCandidates": {
        "RowsPerScan": 50,
        "FinalTopCandidates": 10,
        "UseWishListFirst": true,
        "MaxWishListItems": 100,

        "ScanCodes": [
            {
                "Code": "TOP_OPEN_PERC_LOSE",
                "Description": "Top percentage losers at open."
            },
            {
                "Code": "TOP_PERC_LOSE",
                "Description": "Top percentage losers. Better for watch list after sharp selloff."
            },
            {
                "Code": "HOT_BY_VOLUME",
                "Description": "Most active by volume."
            },
            {
                "Code": "MOST_ACTIVE",
                "Description": "Most active stocks."
            },
            {
                "Code": "TOP_OPEN_PERC_GAIN",
                "Description": "Top percentage gainer at open."
            },
            {
                "Code": "TOP_PERC_GAIN",
                "Description": "Top percentage gainers."
            }
        ],

        "WishListFilter": {
            "MinDollarVolume": 15000000,
            "MaxDistanceTo20dHigh": -5.0,
            "MaxDistanceTo52wHigh": -10.0,
            "MaxDailyMaSignedDistancePct": 15.0,
            "MaxWeeklyMaSignedDistancePct": 10.0,
            "MinWeeklyMaSignedDistancePct": -12.0,
            "MinDailyRsi14": 28.0,
            "MaxDailyRsi14": 55.0,
            "MinWeeklyRsi14": 35.0,
            "MaxDailyMacdLineMinusSignal": 0.0
        },

        "EntryFilter": {
            "MinDollarVolume": 15000000,
            "MaxDistanceTo20dHigh": -1.0,
            "MinCurrentDailyMaSignedDistancePct": -3.0,
            "MinDailyMaDelta3": 0.10,
            "MinDailyRsiDelta3": 0.50,
            "MinDailyRsiDelta3Strong": 1.0,
            "MinDailyMacdDelta3": 0.01,
            "MinDailyTurnSignals": 1,
            "MinH4MaDelta3": 0.05,
            "MinH4RsiDelta3": 0.50,
            "MinH4MacdDelta3": 0.01,
            "MinH4TurnSignals": 1,
            "MinCurrentDailyRsi14": 35.0,
            "MaxCurrentWeeklyMacdLineMinusSignal": 0.5
        },

        "CandidateFilter": {
            "MinDollarVolume": 1000000.0,
            "MaxBbMidSignedDistancePct": 0.5,
            "MaxDistanceTo20dHigh": -20.0,
            "MaxAtrRatio": 0.20
        },

        "Finder": {
            "CandleCount": 600,
            "MinimumCandles": 60,
            "AvgVolumePeriod": 20,
            "LookbackCalendarDays": 240
        },

        "PreFilter": {
            "RequiredCurrency": "USD",
            "DenyList": [ "UVIX", "AGQ", "SCO", "MSTZ" ],
            "AllowedStockTypeMarkers": [ "STK", "CORP", "ADR" ],
            "RejectTickersEndingWith": [ "U", "W" ]
        },

        "TradePlan": {
            "UseCurrentPriceAsEntry": true,
            "MinimumCandles": 10,
            "StopLookbackBars": 5,
            "StopBufferMultiplier": 0.99,
            "FallbackStopMultiplier": 0.97,
            "RiskRewardRatio": 2.0,
            "DefaultProfitPct": 0.05,
            "MinProfitPct": 0.03,
            "MaxProfitPct": 0.10,
            "H4TargetLookbackBars": 24,
            "EntryPullbackAtrFraction": 0.20,
            "MinimumEntryDiscountPct": 0.0015,
            "MinimumEntryDiscountAtrFraction": 0.10
        },

        "NextDayRanking": {
            "EntryScoreWeight": 0.35,
            "CandidateScoreWeight": 0.20,
            "TrendPositionWeight": 0.15,
            "DailyTrendPositionWeight": 0.10,
            "AtrRatioWeight": 0.10,
            "BbMidWeight": 0.05,
            "PresetWeight": 0.05,

            "EntryScoreNormMax": 120.0,
            "CandidateScoreNormMax": 140.0,
            "TrendPositionNormMax": 10.0,
            "DailyTrendPositionNormMax": 6.0,
            "AtrRatioNormMax": 4.0,
            "BbMidNormMax": 8.0,

            "EntryScoreBonusThreshold": 100.0,
            "EntryScoreBonus": 0.08,
            "TrendPositionBonusThreshold": 6.0,
            "TrendPositionBonus": 0.05,
            "DailyTrendPositionBonusThreshold": 3.0,
            "DailyTrendPositionBonus": 0.05,
            "AtrRatioBonusThreshold": 2.8,
            "AtrRatioBonus": 0.05,

            "DailyTrendNegativePenaltyThreshold": 0.0,
            "DailyTrendNegativePenalty": 0.08,
            "BbMidNegativePenaltyThreshold": 0.0,
            "BbMidNegativePenalty": 0.05,

            "HotByVolumePresetBonus": 1.0,
            "MostActivePresetBonus": 0.9,
            "TopPercGainPresetBonus": 0.7,
            "TopPercLosePresetBonus": 0.4,
            "TopOpenPercGainPresetBonus": 0.2,
            "TopOpenPercLosePresetBonus": 0.1,
            "DefaultPresetBonus": 0.0
        }
    },

    "CandidateEvaluation": {
        "SearchPattern": "candidates_*.json",
        "ForwardEvaluationDays": 7,
        "FreshDataSafetyLagMinutes": 10,
        "DefaultTargetPct": 10.0,
        "UseAmbiguousBarResolver": true
    },

    "WishListEvaluation": {
        "HistoryDaysToLoad": 90,
        "MaxAdditionalDropFromWishListPct": -12.0,
        "MinCurrentDailyRsi14": 30.0,
        "MaxCurrentDailyMacdLineMinusSignal": -1.5,
        "MinWeeklyMaSignedDistancePct": -14.0,
        "MaxDaysInWishListWithoutImprovement": 10,
        "MinDailyMaDelta3ToKeep": 0.0,
        "MinDailyRsiDelta3ToKeep": 0.0,
        "MinDailyMacdDelta3ToKeep": 0.0
    },

    "CleanUp": {
        "RemoveEvaluatedCandidates": true,
        "CandidateOutcomesToRemove": [
            "Loss"
        ],
        "RemoveStaleWishListItems": true,
        "RemoveWishListWithoutTargetOlderThanDays": 14,
        "RemoveWishListPastExpectedTargetGraceDays": 2,
        "DeleteLogsOlderThanCutoff": true,
        "DeleteLegacyCandidatesOlderThanCutoff": true,
        "DeleteLegacyEvaluationsOlderThanCutoff": true,
        "FileRetentionDays": 3
    },

    "CsvTradeReader": {
        "Separator": ";",
        "HasHeader": true,
        "Columns": [
            {
                "Name": "HoldDays",
                "Index": 0
            },
            {
                "Name": "ProfitPercent",
                "Index": 1
            },
            {
                "Name": "Ticker",
                "Index": 2
            },
            {
                "Name": "EntryDate",
                "Index": 3
            },
            {
                "Name": "EntryTime",
                "Index": 4
            },
            {
                "Name": "EntryPrice",
                "Index": 6
            },
            {
                "Name": "ExitDate",
                "Index": 10
            },
            {
                "Name": "ExitTime",
                "Index": 11
            },
            {
                "Name": "ExitPrice",
                "Index": 13
            },
            {
                "Name": "IsShort",
                "Index": 19
            }
        ]
    },

    "Logging": {
        "EnableFileLogging": true,
        "FileMinimumLevel": "Info",
        "ConsoleMinimumLevel": "Info",
        "EnableColors": true
    }
}
